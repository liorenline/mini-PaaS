#!/usr/bin/env bash
set -Eeuo pipefail

PLATFORM_DIR="${PLATFORM_DIR:-/vagrant/platform}"
source "$PLATFORM_DIR/config.sh"

setup_colors() {
  if [[ -t 2 ]] && [[ -z "${NO_COLOR-}" ]] && [[ "${TERM-}" != "dumb" ]]; then
    NOFORMAT='\033[0m' RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
  else
    NOFORMAT='' RED='' GREEN='' YELLOW=''
  fi
}

msg() {
  echo >&2 -e "${1-}"
}

setup_colors

GIT_DIR="$(pwd)"
APP_NAME="$(basename "$GIT_DIR" .git)"
PORT="$(git config --get paas.port || true)"
TARGET="$BUILD_DIR/$APP_NAME"

if [ -z "$APP_NAME" ]; then
  msg "${RED}error: could not determine app name${NOFORMAT}"
  exit 1
fi

if [ -z "$PORT" ]; then
  msg "${RED}error: port not set, run: git config paas.port <port> in $GIT_DIR${NOFORMAT}"
  exit 1
fi

msg "Received push for ${GREEN}$APP_NAME${NOFORMAT}"

rm -rf "$TARGET"
mkdir -p "$TARGET"

unset GIT_INDEX_FILE
git --work-tree="$TARGET" --git-dir="$GIT_DIR" checkout -f "$DEPLOY_BRANCH"
msg "${GREEN}Got the code${NOFORMAT}"

"$PLATFORM_DIR/deploy.sh" "$APP_NAME" "$TARGET" "$PORT"